# Server
PORT=8080

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# JWT
JWT_SECRET=your-jwt-secret-key

# Frontend
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Speech-to-text (voice transaction entry)
# STT_ENABLED turns the /api/voice/* endpoints on.
STT_ENABLED=true
# Full endpoint URL. Inside docker-compose the service name is whisper-stt.
# whisper.cpp server uses /inference; use /v1/audio/transcriptions for OpenAI/Groq.
STT_URL=http://whisper-stt:8080/inference
# Optional bearer token (required for Groq/OpenAI, empty for self-hosted).
STT_API_KEY=
# Spoken language hint (id = Indonesian).
STT_LANGUAGE=id
STT_TIMEOUT_SECONDS=30
