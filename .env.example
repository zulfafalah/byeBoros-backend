# Server
PORT=8080

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# JWT
JWT_SECRET=your-jwt-secret-key

# Frontend
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Speech-to-text (voice transaction entry)
# STT_ENABLED turns the /api/voice/* endpoints on.
STT_ENABLED=true
# Full endpoint URL. Self-hosted whisper.cpp uses /inference; OpenAI/Groq use
# /v1/audio/transcriptions.
STT_URL=http://whisper-stt:8080/inference
# Optional bearer token (required for Groq/OpenAI, empty for self-hosted).
STT_API_KEY=
# Model name (required for Groq/OpenAI, e.g. whisper-large-v3-turbo; leave empty
# for self-hosted whisper.cpp which serves whatever model it was started with).
STT_MODEL=
# Spoken language hint (id = Indonesian).
STT_LANGUAGE=id
STT_TIMEOUT_SECONDS=30
# Beam search width (self-hosted only; 0 omits the field, required for Groq).
STT_BEAM_SIZE=0
# Optional domain hint sent to the model to bias spelling/numbers.
STT_PROMPT=Catatan keuangan berbahasa Indonesia. Contoh nominal: sepuluh ribu, lima puluh ribu, seratus ribu, lima juta.
# --- Self-hosted whisper.cpp only (ignored for cloud) ---
# Model file inside ./models. Bigger = more accurate, slower.
# ggml-base.bin < ggml-small.bin < ggml-medium.bin < ggml-large-v3-turbo-q5_0.bin
STT_MODEL_FILE=ggml-large-v3-turbo-q5_0.bin
STT_THREADS=4

# Category classification (LLM, OpenAI-compatible chat completions)
# When enabled, the spoken description is sent to the LLM to pick the best
# category; on any error it falls back to keyword matching.
LLM_ENABLED=false
LLM_URL=https://api.groq.com/openai/v1/chat/completions
# Empty falls back to STT_API_KEY.
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=15
